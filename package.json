{
  "name": "failure-report",
  "version": "0.1.0",
  "private": true,
  "description": "Eve-first Failure in the Loop system for durable, shared AI-agent diagnosis workflows.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.18.1",
      "onFail": "download"
    }
  },
  "scripts": {
    "build": "turbo run build && pnpm run build:codex-plugin",
    "build:codex-plugin": "node packages/mcp-adapter/scripts/build-codex-plugin-bundle.mjs",
    "check": "turbo run check && pnpm run check:codex-plugin",
    "check:codex-plugin": "node packages/mcp-adapter/scripts/build-codex-plugin-bundle.mjs --check",
    "halo:trace-capture-real": "pnpm --filter @Alive24/FailureReport run dev:preflight && node eve/scripts/real-root-codex-trace-capture.mjs",
    "test": "turbo run test",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "esbuild": "^0.27.7",
    "prettier": "^3.6.2",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
