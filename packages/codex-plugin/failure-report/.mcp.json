{
  "failure-report": {
    "command": "node",
    "args": ["./mcp/server.mjs"],
    "cwd": ".",
    "env_vars": [
      "FAILURE_REPORT_RUNTIME_MODE",
      "FAILURE_REPORT_EVE_HOST",
      "FAILURE_REPORT_EVE_BEARER_TOKEN",
      "FAILURE_REPORT_REMOTE_REPOSITORY",
      "FAILURE_REPORT_TRUSTED_REPOSITORIES",
      "FAILURE_REPORT_RUNTIME_ROOT",
      "FAILURE_REPORT_RUNTIME_STATE_ROOT",
      "FAILURE_REPORT_RUNTIME_READINESS_TIMEOUT_MS",
      "FAILURE_REPORT_RUNTIME_POLL_INTERVAL_MS",
      "FAILURE_REPORT_RUNTIME_IDLE_TIMEOUT_MS"
    ],
    "tool_timeout_sec": 900
  }
}
